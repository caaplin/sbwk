# SBWK root environment for docker compose.
# Generate strong high-entropy secrets (>= 32 random chars), e.g.:
#   openssl rand -hex 32
# Placeholder or short secrets are rejected at boot when NODE_ENV=production.

# Shared between Middleware, Control Plane, and Agent Core.
AGENT_CORE_TOKEN=replace-with-openssl-rand-hex-32-agent-core
# Protects the Middleware /_sbwk admin endpoints.
MIDDLEWARE_ADMIN_TOKEN=replace-with-openssl-rand-hex-32-middleware
# Shared between Agent Core, Control Plane, and Agent Connector.
CONNECTOR_API_TOKEN=replace-with-openssl-rand-hex-32-connector

# Optional: bearer auth + encryption key for the Control Plane (:4300).
CONTROL_PLANE_TOKEN=
CONTROL_PLANE_SECRET=
BLOCK_PRIVATE_NETWORKS=false

# Path mounted read-only into Agent Core for codebase root-cause inspection.
TARGET_CODEBASE_PATH=./services/dummy-server

# Detection threshold: 500 = server errors only; 400 also catches 404, etc.
DETECT_STATUS_MIN=500
DETECT_SLOW_MS=2000
DISPATCH_COOLDOWN_MS=15000

# Reasoning: "mock" needs no API key; "live" uses Groq (retries 429/5xx, falls back to heuristic with degradedFromLive=true).
AGENT_MODE=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ESCALATION_CONFIDENCE_THRESHOLD=0.8

# Connector integrations: "mock" for demos; "live" to hit real HTTP or TCP/TLS dependencies.
CONNECTOR_MODE=mock

# Optional: wake engineers via a webhook (e.g. Slack). Always logged regardless.
NOTIFICATION_WEBHOOK_URL=
