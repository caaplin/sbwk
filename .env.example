# I have already made .env. For security, this is what you get
AGENT_CORE_TOKEN=6c151f111f7c8d989b13a1327ef51ff5682e283bff1c69f2b9b82c47da2a6fd9
MIDDLEWARE_ADMIN_TOKEN=69644d910f151a9e5b88d1e3c4772960d0ebc3282295419dbacaf931af0c2045
CONNECTOR_API_TOKEN=98e989acc6b96a71108fac8c1fcb3ea89251c7b87f9685dc261149aafab22318
CONTROL_PLANE_TOKEN=2631e209631acc9d88f010bbd061aba9634dbef7d6f08c19f4d7b982fd8bf383
CONTROL_PLANE_SECRET=e14b75a1987d01d9e77d088f9dde0377b1acf2c4aa99ca65330f8824e2b0d5aa
CONTROL_PLANE_PASSWORD=oiial
BLOCK_PRIVATE_NETWORKS=false
TARGET_CODEBASE_PATH=./services/dummy-server
DETECT_STATUS_MIN=500
DETECT_SLOW_MS=2000
DISPATCH_COOLDOWN_MS=15000

AGENT_MODE=live
#already implemented. You wont get it
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ESCALATION_CONFIDENCE_THRESHOLD=0.8
CONNECTOR_MODE=agent
NOTIFICATION_WEBHOOK_URL=

# ── Developer Fault Email Notifications (Resend.com, zero-dependency) ─────────
# Get an API key from https://resend.com/api-keys
RESEND_API_KEY=
# Developer email address to receive fault alerts
DEVELOPER_EMAIL=
# Sender address (use onboarding@resend.dev for Resend sandbox, or your verified domain)
RESEND_FROM_EMAIL=onboarding@resend.dev
# Set to true to email on every detected fault, or false to email only on escalations
RESEND_NOTIFY_ALL_INCIDENTS=true

# ── GitHub Integration (for Git Branches tab, last-4 diffs & rollback) ────────
# Optional: can also be configured in the Control Plane Config tab.
# Works with fine-grained single-repo PATs (Contents read/write + Metadata read).
GITHUB_REPO=
GITHUB_TOKEN=

# ── Lazy two-stage gate (opt-in; leave DETECT_MODE=immediate for today's behaviour) ──
DETECT_MODE=immediate
BATCH_MIN_BAD=5
BATCH_WINDOW_MS=60000
BATCH_MAX_SIZE=50
BATCH_LIQUID_ANOMALY_THRESHOLD=0.6
LIQUID_BATCH_FALLBACK=investigate
BATCH_IMPULSE=true
BATCH_IMPULSE_SEVERE_MS=5000
BATCH_SKIP_TRIVIAL=false
