NODE_ENV=development
PORT=4300
DATA_DIR=
REQUEST_TIMEOUT_MS=6000
RATE_LIMIT_PER_MIN=120
GITHUB_API_BASE=https://api.github.com

# Optional security hardening when exposing :4300 beyond localhost.
CONTROL_PLANE_TOKEN=
CONTROL_PLANE_SECRET=
PERSIST_SECRETS=true
BLOCK_PRIVATE_NETWORKS=false
SSRF_ALLOWLIST_HOSTS=
ALLOWED_ORIGINS=

# Downstream services the control plane configures (use Compose DNS names in Docker).
MIDDLEWARE_URL=http://localhost:8080
MIDDLEWARE_ADMIN_TOKEN=development-only-change-this-admin-token-123456
CONNECTOR_URL=http://localhost:4100
CONNECTOR_API_TOKEN=development-only-change-this-token-123456
AGENT_CORE_URL=http://localhost:4200
AGENT_CORE_TOKEN=development-only-change-this-agent-token-123456

# Default gateway target shown in the UI.
DEFAULT_TARGET_URL=http://localhost:8000
